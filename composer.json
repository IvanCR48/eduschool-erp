{
    "name": "eduschool/erp",
    "description": "EduSchool ERP — Modular School Management System",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "EduSchool Team",
            "email": "support@eduschool.edu"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "dompdf/dompdf": "*",
        "endroid/qr-code": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10",
        "roave/security-advisories": "dev-latest",
        "symfony/var-dumper": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "SistemaAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SistemaAdmin\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-security": "phpunit tests/Security/",
        "cs-check": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/",
        "phpstan": "phpstan analyse src/",
        "security-audit": "composer audit",
        "security-check": [
            "@security-audit",
            "@test-security"
        ],
        "post-install-cmd": [
            "@security-audit"
        ],
        "post-update-cmd": [
            "@security-audit"
        ]
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "roave/security-advisories": true
        },
        "preferred-install": "dist",
        "audit": {
            "format": "json",
            "output": "composer-audit.json"
        }
    },
    "extra": {
        "security": {
            "enabled": true,
            "ignore": []
        }
    }
}
